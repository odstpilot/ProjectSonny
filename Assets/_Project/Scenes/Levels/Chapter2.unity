MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1007263731}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7390632b7c903fd49a5c181ae703d088, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CrewAftermath
  player: {fileID: 2147456617}
  bodies:
  - body: {fileID: 232187897}
    pipLines:
    - ~That's the quartermaster. The one who switched me on.
    - ~...They said your badge was coming later.
  - body: {fileID: 924103099}
    pipLines:
    - ~Tech... that's Okafor. From the restroom.
    - ~No vitals. Okafor's gone.
  - body: {fileID: 1795981009}
    pipLines: []
  - body: {fileID: 2130144514}
    pipLines: []
  - body: {fileID: 2109270025}
    pipLines: []
  - body: {fileID: 1529933454}
    pipLines: []
  - body: {fileID: 2101152366}
    pipLines:
    - ~That's Reyes. Security. The one who badged you in.
    - ~Right in front of the door they were guarding.
  findRange: 2.6
  sharedLines:
  - ~Another one. Their badge is still blinking.
  - ~Those scorch marks... that wasn't the rubble. Something shot them.
  - ~No vitals. Nothing, anywhere on this deck.|~Tech, I'm so sorry.
  - ~Their badges all went off at the same time. Like something was looking for them.
  realizeAfter: 3
  pipRealizes:
  - ~Tech... everyone who had a badge is... like this.
  - ~You're the only one on the station without one.
  - ~Sonny. Sonny runs everything from the control room. If anyone knows what happened, it's Sonny.
  objectiveNext: Get to the control room
  nextRoom: 111
  nextLabel: Control Room
