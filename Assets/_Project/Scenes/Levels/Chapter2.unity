  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Workshop
  player: {fileID: 1679943878}
  bench: {fileID: 1725348475}
  emp: {fileID: 11400000, guid: 2c8f4a6e9d1b4c3a7e5f0d8b1c6a4e27, type: 2}
  crowbar: {fileID: 11400000, guid: 8c2f4a71d9e34b6fa1c07e52b3d6a9e4, type: 2}
  scrapGun: {fileID: 11400000, guid: 624a4c24e38a4e64a00e78066607fda2, type: 2}
  blaster: {fileID: 11400000, guid: e5a2d8c14b7f4a9e8d3b6c0f1a2e7d95, type: 2}
  empCost:
  - material: 2
    count: 2
  - material: 1
    count: 3
  - material: 3
    count: 2
  crowbarCost:
  - material: 0
    count: 4
  scrapGunCost:
  - material: 0
    count: 5
  - material: 1
    count: 3
  - material: 2
    count: 2
  - material: 3
    count: 3
  blasterCost:
  - material: 1
    count: 3
  - material: 2
    count: 2
  - material: 3
    count: 2
  servoCost:
  - material: 3
    count: 2
  - material: 2
    count: 1
  - material: 0
    count: 2
  platingCost:
  - material: 0
    count: 4
  - material: 1
    count: 1
  unlockCredential: reactor_core
  lockedText: LOCKED  COMMS RING
  pipUnlocked:
  - ^A unit's access opens the workbench's full plans too. Crowbar, scrap gun, all of it.
  servoSpeedBoost: 1.2
  platingHealth: 2
  scavengeObjective: Find parts for an EMP
  craftObjective: Make an EMP at the workbench
  afterObjective: Find a badge in the comms ring
  afterRoom: 103
  afterLabel: Comms Ring
  pipEnoughScrap:
  - ^That's everything for the EMP. Get it to the workbench.
  pipEmpMade:
  - ^It works! One pulse shorts out any bot or camera in front of you for a few seconds.
  - ~It needs a moment to recharge between pulses. Make them count.
  - ~Now. The way down to the control room's through the reactor core, and the reactor's badge-only. Sonny cut off every badge.
  - ~Try the comms ring, next door. If there's a badge left anywhere, it's there.
  pipCrowbarMade:
  - ~A crowbar. If a bot gets too close, swing first. The number keys switch what you're holding.
  pipScrapGunMade:
  - ^A scrap gun! Point and click. Now we can hit back from a distance.
  pipBlasterMade:
  - ^The blaster. Hold to charge it, let go when it's full.
  pipServoMade:
  - ^Servo braces. You'll move faster now.
  pipPlatingMade:
  - ^Armor plating. You can take more hits.
  respawnAt: {x: 216.5, y: 207.74}
  benchStandAt: {x: 205.5, y: 206.74}
