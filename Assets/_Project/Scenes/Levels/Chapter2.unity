  - {fileID: 546710721}
  - {fileID: 1842666308}
  - {fileID: 1982036070}
  - {fileID: 1291787229}
  - {fileID: 758416038}
  angel: {fileID: 205853368}
  angelStart: {x: 9.5, y: 190.74}
  angelDelay: 10
  deckRoom: 100
  deckFloor: {fileID: 1320564277}
  deckBreachSpots:
  - {x: 195.5, y: 208.74}
  - {x: 201.5, y: 208.74}
  - {x: 209.5, y: 208.74}
  - {x: 219.5, y: 208.74}
  - {x: 222.5, y: 208.74}
  - {x: 227.5, y: 208.74}
  technicianAngelFollows:
  - It followed me!
  arriveObjective: Reactivate your badge in the comms ring
  generatorObjective: Find the generator and get the power back on
  interceptObjective: Intercept Sonny's broadcasts
  answerObjective: Answer Sonny at its relay
  afterObjective: Get into the control room
  afterRoom: 111
  afterLabel: Control Room
  technicianBlackout:
  - No, no, no... the lights...
  pipBlackout:
  - ~Tech, something's draining the suit and I'm gonna lose you
  - '~!Use the EMP, its flash lights up whatever''s in front of you'
  - ~Find the generator and get the power back on, then I can come b-
  technicianAlone:
  - Pip? ...Pip
  technicianAngel:
  - ...Footsteps, and fast ones
  technicianPowerOn:
  - Power, finally
  pipBack:
  - ~...Tech? There you are! You got the power back on
  technicianArrive:
  - Every screen up here's still running
  pipArrive:
  - ~See that pillar with the red eye? That's Sonny's relay, it's how it checks on its units, and it talks to every badge aboard
  - ~If it thinks you're one of them it'll switch your badge back on with a unit's access, and units get into the control room
  - ~But it'll quiz you first... the comms nodes are carrying its broadcasts, so tune them in and listen to how the bots talk
  pipIntercepted:
  - ~Uh oh, it heard that... something's moving in the walls
  - '~!One more, and remember what they said, ''cause that''s what it''ll ask'
  pipAllIntercepted:
  - ~That's all of them, the relay's listening now
  - '~!Answer like a bot would, not like you would, and don''t hesitate ''cause it notices'
  technicianVerified:
  - It... thinks I'm one of them.
  pipVerified:
  - ^Your badge is back on as a unit's, so the reactor and the control room will open for you
  - ~Through the reactor and down its stairs, go!
  pipAlarm:
  - ~It knows! Get away from there, it'll let you try again in a bit.
  breachBots:
  - {fileID: 303392399}
  - {fileID: 240273932}
  - {fileID: 626938612}
  - {fileID: 2139895874}
  - {fileID: 1227533885}
  - {fileID: 1224506218}
  breachPoints:
  - {fileID: 1729948178}
  - {fileID: 803116766}
