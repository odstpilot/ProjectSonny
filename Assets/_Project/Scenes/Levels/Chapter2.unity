  crowbar: {fileID: 11400000, guid: 8c2f4a71d9e34b6fa1c07e52b3d6a9e4, type: 2}
  empCost:
  - material: 2
    count: 1
  - material: 1
    count: 2
  - material: 3
    count: 1
  crowbarCost:
  - material: 0
    count: 2
  scavengeObjective: Find parts for an EMP
  craftObjective: Make an EMP at the workbench
  afterObjective: Cross the deck to the comms ring
  afterRoom: 103
  afterLabel: Comms Ring
  pipEnoughScrap:
  - ^That's everything for the EMP. Get it to the workbench.
  pipEmpMade:
  - ^It works! One pulse shorts out any bot or camera in front of you for a few seconds.
  - ~It needs a moment to recharge between pulses. Make them count.
  - ~Now, the comms ring, through the far door. Every system on the station talks through it. If I can get in, maybe I can get you into the control room.
  pipCrowbarMade:
  - ~A crowbar. If a bot gets too close, swing first. [1] and [2] switch between what you're holding.
  respawnAt: {x: 220.5, y: 222.74}
  benchStandAt: {x: 216.5, y: 221.74}
