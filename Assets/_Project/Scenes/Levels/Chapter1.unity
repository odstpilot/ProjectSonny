MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2108322478}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 78bec8ac8307fa948a6881d0ca2fa633, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RestroomBreak
  player: {fileID: 2002544574}
  toilet: {fileID: 1945857623}
  occupiedToilet: {fileID: 1575639112}
  attendant: {fileID: 1068567523}
  attendantComesIn: {fileID: 102944974}
  crate: {fileID: 1306418570}
  shelf: {fileID: 1034024593}
  exploreSeconds: 50
  talksBeforeUrge: 3
  urgeShake: 0.35
  urgeLines:
  - Oof.
  - I've been holding that since before the install. Restroom. Now.
  pipUrge:
  - ^Restroom's off the lounge. I pinned it on your map!
  nags:
  - Walk faster. Walk faster.
  - Think dry thoughts. Think dry thoughts.
  nagSeconds: 22
  objectiveUrge: Find the restroom
  restroomRoom: 119
  restroomLabel: Restroom
  notYet: I don't need to go. Not yet, anyway.
  alreadyWent: Already went. I'm good.
  flushSound: Toilet Flush
  blackoutSeconds: 2.2
  beforeFlush: Here goes nothing...
  asItBreaks: No. No no no no no!
  technicianHearsIt: ...That didn't sound good.
  attendantCallOut: Oh, come ON. Not this one too!
  askToFix:
  - That's two down. Two! There's one toilet left on this whole deck, and I'm not sharing it with the night shift.
  - Hang on. The suit, no badge... You're the new technician. The one who brought the AI up.
  - '* That''s me. = Then you''re exactly who I need.'
  - '* Who''s asking? = Okafor. Life support. The man who''s about to ask you a favor.'
  - Could you fix it up for me? Please?
  - '* Sure, I''ll fix it. = You''re a lifesaver. Tools are in the storage room, the door on the east side of the lounge.'
  - '* Not really my job. = Please. Nobody else up here knows which end of a wrench to hold. = And the chief hears about everything that happens on this deck. Everything. = Tools are in the storage room, the door on the east side of the lounge. I''ll owe you.'
  attendantAfter:
  - Storage room. East side of the lounge. A wrench should do it. I'll guard the last one.
  agreed:
  - Toilet duty. On day one.
  - ...Still. The new tech who fixes things. That'll look good to the chief.
  refused:
  - ...He's not going to let this go, is he.
  - Fine. The new tech fixing things on day one? That'll look good to the chief.
  objectiveFix: Get a wrench from the storage room
  toolsRoom: 115
  toolsLabel: Storage Room
  enterStorage: Wrench, wrench, wrench...
  objectiveSearch: Find a wrench
  nothingNeeded: Nothing I need in there.
  crateEmpty:
  - Empty.
  - '"Borrowed the wrench. Back soon. -D."'
  - ...Of course.
  - Wait. Something's shining under that shelf.
  crateStillEmpty: Still just the note.
  objectiveShelf: Check under the shelf
  crateFirst: Tool crate first. That's where a wrench should be.
  reachPresses: 5
  reachLines:
  - Come on...
  - 
  - Almost...
  - 
  - Got... it...
  gotIt: Got it!
  rumbleSound: Distant Rumble
  rumbleShake: 0.18
  whatWasThat: ...What was that?
  pipShelfWobble:
  - ~Tech? Something big's moving through the sta-
  quakeSound: Station Quake
  quakeShake: 0.55
  quakeAfterSeconds: 0.8
  hitShake: 1
  goingDownSeconds: 0.9
  timeSkip:
  - Chapter 2
  - A few hours later
  timeSkipHoldSeconds: 1.8
  wakeUpScene: Chapter2
