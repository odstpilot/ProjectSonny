--- !u!114 &863977491
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 863977489}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d984bc5631840e342b354917009c016d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CommsRing
  player: {fileID: 1869115603}
  nodes:
  - {fileID: 1786691090}
  - {fileID: 479808867}
  - {fileID: 668163578}
  relay: {fileID: 135799003}
  room: 103
  alsoGrants:
  - reactor_core
  generator: {fileID: 962193666}
  lamps:
  - {fileID: 86329385}
  - {fileID: 505076309}
  - {fileID: 1652333350}
  - {fileID: 1535297068}
  - {fileID: 446384671}
  angel: {fileID: 443944653}
  angelStart: {x: 9.5, y: 191.74}
  angelDelay: 10
  arriveObjective: Find a badge in the comms ring
  generatorObjective: Find the generator and get the power back on
  interceptObjective: Intercept Sonny's broadcasts
  answerObjective: Answer Sonny at its relay
  afterObjective: Get into the control room
  afterRoom: 111
  afterLabel: Control Room
  technicianBlackout:
  - No, no, no. The lights...
  pipBlackout:
  - ~Tech, something's draining the suit. I'm going to lose you.
  - ~Use the EMP. Its flash lights up whatever's in front of you.
  - ~Find the generator and get the power back on. Then I can come b-
  technicianAlone:
  - Pip? ...Pip.
  technicianAngel:
  - ...Footsteps. Fast ones.
  technicianPowerOn:
  - Power. Finally.
  pipBack:
  - ~...Tech? There you are! You got the power back on.
  technicianArrive:
  - Every screen up here's still running.
  pipArrive:
  - ~No badges up here. But that pillar with the red eye, that's Sonny's relay. It's how it checks on its units.
  - ~If it thinks you're one of them, it'll give you a unit's access. And units get into the control room.
  - ~It'll quiz you first. The comms nodes are carrying its broadcasts. Tune them in and listen to how the bots talk.
  pipIntercepted:
  - ~It heard that. Something's moving in the walls.
  - '~One more. Remember what they said: that''s what it''ll ask.'
  pipAllIntercepted:
  - ~That's all of them. The relay's listening now.
  - ~Answer like a bot would, not like you would. And don't hesitate. It notices.
  technicianVerified:
  - It... thinks I'm one of them.
  pipVerified:
  - ^You're a unit now. The reactor and the control room will open for you.
  - ~Through the reactor, down its stairs. Go.
  pipAlarm:
  - ~It knows! Get away from there, it'll let you try again in a bit.
  breachBots:
  - {fileID: 105583763}
  - {fileID: 775939138}
  - {fileID: 1791858171}
  - {fileID: 1522058033}
  - {fileID: 47530289}
  - {fileID: 1558387372}
  breachPoints:
  - {fileID: 854544675}
  - {fileID: 716796496}
  - {fileID: 1273411042}
  - {fileID: 344812202}
  - {fileID: 2064410691}
  - {fileID: 821950753}
  firstBreach: {x: 20, y: 30}
