  m_Script: {fileID: 11500000, guid: 78bec8ac8307fa948a6881d0ca2fa633, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RestroomBreak
  player: {fileID: 1948281618}
  toilet: {fileID: 303171352}
  occupiedToilet: {fileID: 57934884}
  attendant: {fileID: 1763446925}
  attendantComesIn: {fileID: 1089663451}
  crate: {fileID: 1415533396}
  shelf: {fileID: 1186213308}
  skipRestroom: 1
  exploreSeconds: 50
  talksBeforeUrge: 3
  urgeShake: 0.35
  urgeLines:
  - Oof
  - Uhh, I've been holding that since before the install... restroom, right now
  nags:
  - Walk faster, walk faster, walk faster
  - Think dry thoughts... dry thoughts
  nagSeconds: 22
  objectiveUrge: Find the restroom
  restroomRoom: 119
  restroomLabel: Restroom
  notYet: I don't need to go, not yet anyway
  alreadyWent: Already went, I'm good
  flushSound: Toilet Flush
  blackoutSeconds: 2.2
  beforeFlush: Here goes nothing...
  asItBreaks: No, no no no no no!
  technicianHearsIt: ...That didn't sound good
  attendantCallOut: Oh, come ON, not this one too!
  askToFix:
  - That's two down, two! There's one toilet left on this whole deck and I'm not sharing it with the night shift
  - Hang on, the suit, the temp badge... you're the new technician, the one who brought the AI up
  - '* That''s me = Then you''re exactly who I need'
  - '* Who''s asking? = Okafor, life support, and the guy who''s about to ask you a favor'
  - Could you fix it up for me? Please?
  - '* Sure, I''ll fix it = You''re a lifesaver, man, tools are in the storage room, the door on the east side of the lounge'
  - '* Not really my job = C''mon, please, nobody else up here knows which end of a wrench to hold = And the chief hears about everything that happens on this deck... and I mean everything = Tools are in the storage room, the door on the east side of the lounge, and I''ll owe you one'
  attendantAfter:
  - Don't mind me, I'll just guard the last working one
  agreed:
  - Toilet duty, on day one... damn
  - ...Still, the new tech who fixes things, that'll look good to the chief
  refused:
  - ...He's not gonna let this go, is he
  - Fine, fine... the new tech fixing stuff on day one? That'll look good to the chief, I guess
  objectiveFix: Get the spare data chip from the storage room
  toolsRoom: 115
  toolsLabel: Storage Room
  enterStorage: Spare data chip... where would they keep it?
  objectiveSearch: Find the spare data chip
  nothingNeeded: Nothing I need in there
  crateEmpty:
  - '"Took the spare data chip. Back soon. -D."'
  - ...Wait, something's shining under that shelf
  crateStillEmpty: Still just the note
  objectiveShelf: Check under the shelf
  crateFirst: Tool crate first, that's where the spares live
  reachLine: Come on... almost...
  gotIt: Got it!
  rumbleSound: Distant Rumble
  rumbleShake: 0.18
  whatWasThat: ...What was that?
  quakeSound: Station Quake
  quakeShake: 0.55
  quakeAfterSeconds: 0.8
  hitShake: 1
  goingDownSeconds: 0.9
  timeSkip:
  - Chapter 2
  - A few hours later
  timeSkipHoldSeconds: 1.8
  wakeUpScene: Chapter2
